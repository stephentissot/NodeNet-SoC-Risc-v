# 25MHz Clock
LOCATE COMP "clk_25mhz" SITE "P3";
IOBUF PORT "clk_25mhz" IO_TYPE=LVCMOS33;
FREQUENCY NET "clk_25mhz" 25.000000 MHz;

# Status LED (D2)
LOCATE COMP "led_d2" SITE "L2";
IOBUF PORT "led_d2" IO_TYPE=LVCMOS33;

# NodeNet activity LEDs + wb_led outputs
# led_g18: NodeNet RX activity (default ON, pulses OFF on RX)
LOCATE COMP "led_g18" SITE "E5";
IOBUF PORT "led_g18" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=UP;
# led_h18: NodeNet TX activity pulse
LOCATE COMP "led_h18" SITE "F4";
IOBUF PORT "led_h18" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=UP;
# led_e18: wb_led LED0 output
LOCATE COMP "led_e18" SITE "F5";
IOBUF PORT "led_e18" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=UP;
# led_e16: wb_led LED1 output
LOCATE COMP "led_e16" SITE "E6";
IOBUF PORT "led_e16" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=UP;
# led_f17: red led cpu trap
LOCATE COMP "led_f17" SITE "F17";
IOBUF PORT "led_f17" IO_TYPE=LVCMOS33 DRIVE=8 PULLMODE=UP;


# SPI Flash (W25Q64) — Configuration Flash Access
# SCK driven via USRMCLK (internal to FPGA), not a GPIO pin
LOCATE COMP "flash_cs_n" SITE "R2";
LOCATE COMP "flash_miso" SITE "V2";
LOCATE COMP "flash_mosi" SITE "W2";
IOBUF PORT "flash_cs_n" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_miso" IO_TYPE=LVCMOS33;
IOBUF PORT "flash_mosi" IO_TYPE=LVCMOS33;

