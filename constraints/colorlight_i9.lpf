LOCATE COMP "sdram_dq[20]" SITE "C11"; IOBUF PORT "sdram_dq[20]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[21]" SITE "D12"; IOBUF PORT "sdram_dq[21]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[22]" SITE "E9";  IOBUF PORT "sdram_dq[22]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[23]" SITE "C12"; IOBUF PORT "sdram_dq[23]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[24]" SITE "E14"; IOBUF PORT "sdram_dq[24]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[25]" SITE "C15"; IOBUF PORT "sdram_dq[25]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[26]" SITE "E13"; IOBUF PORT "sdram_dq[26]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[27]" SITE "D15"; IOBUF PORT "sdram_dq[27]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[28]" SITE "E12"; IOBUF PORT "sdram_dq[28]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[29]" SITE "B17"; IOBUF PORT "sdram_dq[29]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[30]" SITE "D14"; IOBUF PORT "sdram_dq[30]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[31]" SITE "D13"; IOBUF PORT "sdram_dq[31]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;


# NodeNet485 (UART @ 1 Mb/s on G5/D16, RS485 driver enable automatic on module)
LOCATE COMP "rx0" SITE "G5";  # RX input for NodeNet485
IOBUF PORT "rx0" IO_TYPE=LVCMOS33 DRIVE=8;
LOCATE COMP "tx0" SITE "D16";  # TX output for NodeNet485
IOBUF PORT "tx0" IO_TYPE=LVCMOS33 DRIVE=8;

# I2C0 — moved pins on Colorlight i9 (external 4.7 kΩ pullup to 3.3 V required)
# PULLMODE=UP: add internal pullup
# OPENDRAIN=ON: pin releases to high-Z when not driven (external pullup takes over)
LOCATE COMP "i2c0_scl" SITE "D18"; IOBUF PORT "i2c0_scl" IO_TYPE=LVCMOS33 PULLMODE=UP OPENDRAIN=ON;
LOCATE COMP "i2c0_sda" SITE "D17"; IOBUF PORT "i2c0_sda" IO_TYPE=LVCMOS33 PULLMODE=UP OPENDRAIN=ON;

# UART#1 (UART @ 1 Mb/s on E16/E17)
LOCATE COMP "rx1" SITE "E16";  # rx1
IOBUF PORT "rx1" IO_TYPE=LVCMOS33 DRIVE=8;
LOCATE COMP "tx1" SITE "E17";  # tx1
IOBUF PORT "tx1" IO_TYPE=LVCMOS33 DRIVE=8;