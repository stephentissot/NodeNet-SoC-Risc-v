# SDRAM (M12L64322A — 512K × 32 × 4 banks = 8MB)
# Source: https://github.com/wuxx/Colorlight-FPGA-Projects/blob/master/colorlight_i9_v7.2.md
# Note: CS_N=GND, CKE=VCC, DQM[3:0]=GND on PCB (not connected to FPGA)
LOCATE COMP "sdram_clk"    SITE "B9";  IOBUF PORT "sdram_clk"    IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_ras_n"  SITE "B10"; IOBUF PORT "sdram_ras_n"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_cas_n"  SITE "A9";  IOBUF PORT "sdram_cas_n"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_we_n"   SITE "A10"; IOBUF PORT "sdram_we_n"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_ba[0]"  SITE "B11"; IOBUF PORT "sdram_ba[0]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_ba[1]"  SITE "C8";  IOBUF PORT "sdram_ba[1]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[0]"   SITE "B13"; IOBUF PORT "sdram_a[0]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[1]"   SITE "C14"; IOBUF PORT "sdram_a[1]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[2]"   SITE "A16"; IOBUF PORT "sdram_a[2]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[3]"   SITE "A17"; IOBUF PORT "sdram_a[3]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[4]"   SITE "B16"; IOBUF PORT "sdram_a[4]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[5]"   SITE "B15"; IOBUF PORT "sdram_a[5]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[6]"   SITE "A14"; IOBUF PORT "sdram_a[6]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[7]"   SITE "A13"; IOBUF PORT "sdram_a[7]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[8]"   SITE "A12"; IOBUF PORT "sdram_a[8]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[9]"   SITE "A11"; IOBUF PORT "sdram_a[9]"   IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[10]"  SITE "B12"; IOBUF PORT "sdram_a[10]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[0]"  SITE "B6";  IOBUF PORT "sdram_dq[0]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[1]"  SITE "A5";  IOBUF PORT "sdram_dq[1]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[2]"  SITE "A6";  IOBUF PORT "sdram_dq[2]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[3]"  SITE "A7";  IOBUF PORT "sdram_dq[3]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[4]"  SITE "C7";  IOBUF PORT "sdram_dq[4]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[5]"  SITE "B8";  IOBUF PORT "sdram_dq[5]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[6]"  SITE "B5";  IOBUF PORT "sdram_dq[6]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[7]"  SITE "A8";  IOBUF PORT "sdram_dq[7]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[8]"  SITE "D8";  IOBUF PORT "sdram_dq[8]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[9]"  SITE "D7";  IOBUF PORT "sdram_dq[9]"  IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[10]" SITE "E8";  IOBUF PORT "sdram_dq[10]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[11]" SITE "D6";  IOBUF PORT "sdram_dq[11]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_dq[12]" SITE "C6";  IOBUF PORT "sdram_dq[12]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
