# Build outputs
/build/
/xpacks/
/node_modules/
/src/firmware/build/
/src/firmware/.cache/
/.venv*/

# Generic generated files
*.o
*.elf
*.hex
*.bit
*.vvp
*.bak

# Keep source JSON, ignore generated machine outputs in build/ only
/build/**/*.json

# IDE and local workspace state
.DS_Store
.history/
.vs/
**/.vs/
.vscode/*
!.vscode/tasks.json
*.csproj.user

# .NET / NuGet generated directories
**/bin/
**/obj/
**/packages/

# App-local runtime configs generated next to .exe
tools/**/bin/**/*.config

# KiCad transient files (keep .kicad_pro/.kicad_sch/.kicad_pcb tracked)
*.kicad_prl
*.kicad_pro-bak
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_wks-bak
*.sch-bak
*.kicad_pcb.lck
*.kicad_sch.lck
*.kicad_pro.lck
fp-info-cache

# Preserve repository data JSON files
!modbusLib/
!modbusLib/*.json
