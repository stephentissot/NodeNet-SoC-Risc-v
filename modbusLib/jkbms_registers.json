      "bits": {
        "0": "Low capacity (warning)",
        "1": "MOSFET overtemperature (alarm)",
        "2": "Charge overvoltage (alarm)",
        "3": "Discharge undervoltage (alarm)",
        "4": "Battery overtemperature (alarm)",
        "5": "Charge overcurrent (alarm)",
        "6": "Discharge overcurrent (alarm)",
        "7": "Cell pressure difference (alarm)",
        "8": "Battery box overtemperature (alarm)",
        "9": "Battery undertemperature (alarm)",
        "10": "Cell overvoltage (alarm)",
        "11": "Cell undervoltage (alarm)",
        "12": "309_A protection (alarm)",
        "13": "309_A protection (alarm)"
      }
    },
