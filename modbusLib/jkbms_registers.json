{
  "device": "JK BMS (JK02_24S / JK02_32S protocol)",
  "protocol": "JK BMS Proprietary UART",
  "protocol_note": "NOT standard Modbus RTU. The BMS uses a TLV (Tag-Length-Value) binary frame over UART at 115200 baud. The 'address' field is the frame TAG byte (decimal) emitted in the status response frame (function 0x06). Write uses function 0x02 + tag byte.",
  "slave_address": 1,
  "baud_rate": 115200,
  "esphome_component": "github://syssi/esphome-jk-bms@main",
  "frame_header": "0x4E 0x57",
  "note": "All values are parsed from a single status frame (function=0x06). 'scale' and 'offset' give: physical_value = raw * scale + offset. Cell voltages use a dynamic offset based on cell count.",
  "registers": [
    {
      "address": 121,
      "tag_hex": "0x79",
      "name": "Cell Voltages",
      "category": "cells",
      "data_type": "U16 x N (3 bytes per cell: tag_index + U16)",
      "unit": "V",
      "scale": 0.001,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor (cell_voltage_1..24)",
      "note": "First byte of frame data is the total byte count (N cells * 3). Cells 1 to 24 supported. Also derived: min_cell_voltage, max_cell_voltage, delta_cell_voltage, average_cell_voltage, min_voltage_cell, max_voltage_cell."
    },
    {
      "address": 128,
      "tag_hex": "0x80",
      "name": "MOSFET Temperature",
      "category": "temperature",
      "data_type": "U16",
      "unit": "°C",
      "scale": 1,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor",
      "note": "Special decode: if raw > 99, value = 99 - raw (negative temperatures encoded as 100+abs(T))."
    },
    {
      "address": 129,
      "tag_hex": "0x81",
      "name": "Temperature Sensor 1 (Battery Box)",
      "category": "temperature",
      "data_type": "U16",
      "unit": "°C",
      "scale": 1,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor",
      "note": "Same special decode as MOSFET temperature."
    },
    {
      "address": 130,
      "tag_hex": "0x82",
      "name": "Temperature Sensor 2 (Battery)",
      "category": "temperature",
      "data_type": "U16",
      "unit": "°C",
      "scale": 1,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor",
      "note": "Same special decode as MOSFET temperature."
    },
    {
      "address": 131,
      "tag_hex": "0x83",
      "name": "Total Voltage",
      "category": "battery",
      "data_type": "U16",
      "unit": "V",
      "scale": 0.01,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor"
    },
    {
      "address": 132,
      "tag_hex": "0x84",
      "name": "Current",
      "category": "battery",
      "data_type": "U16 (sign in bit 15)",
      "unit": "A",
      "scale": 0.01,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor",
      "note": "Bit 15 = sign: 1 = positive (charging/discharge per protocol_version). Protocol v1: bit15=1 → positive current. Also used to compute Power, Charging Power, Discharging Power (derived = total_voltage × current)."
    },
    {
      "address": 133,
      "tag_hex": "0x85",
      "name": "State of Charge (SOC)",
      "category": "battery",
      "data_type": "U8",
      "unit": "%",
      "scale": 1,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor"
    },
    {
      "address": 134,
      "tag_hex": "0x86",
      "name": "Temperature Sensor Count",
      "category": "system",
      "data_type": "U8",
      "unit": null,
      "scale": 1,
      "offset": 0,
      "access": "read",
      "esphome_type": "sensor"
    },
    {
