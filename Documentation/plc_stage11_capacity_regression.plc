; Capacity regression: 69 public vars in one slot to exercise the raised catalog cap.
; Only a few sentinels are touched at runtime; the remaining declarations stress slot-variable publication.

; U32 path: 1 -> 100 and a simple ordered compare.
PUSH_TRUE
BOOL_TO_U32
PUSH_U32 99
ADD
DUP
STORE_U32 u32Value0

DUP
PUSH_U32 100
EQ
STORE_BOOL u32MathOk

DUP
STORE_U32 u32Value31

PUSH_U32 90
GT

; I32 path: sign-extend, duplicate to two public vars, then round-trip to INT.
PUSH_I16 -123
SX_I16_TO_I32
DUP
STORE_I32 i32Value0

DUP
STORE_I32 i32Value31

DUP
TRUNC_I32_TO_I16
STORE_I16 i16RoundTrip

PUSH_I32 -123
EQ
STORE_BOOL i32MathOk

AND
STORE_BOOL compareOk

LOAD_BOOL u32MathOk
LOAD_BOOL i32MathOk
AND
LOAD_BOOL compareOk
AND
STORE_BOOL allOk

HALT