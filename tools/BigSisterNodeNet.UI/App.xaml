<Application x:Class="BigSisterNodeNet.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:viewModels="clr-namespace:BigSisterNodeNet.UI.Models"
             xmlns:instrumentViewModels="clr-namespace:BigSisterNodeNet.UI.Models.Instruments"
             xmlns:views="clr-namespace:BigSisterNodeNet.UI.Views"
             xmlns:instrumentsViews="clr-namespace:BigSisterNodeNet.UI.Views.Instruments"
             xmlns:core="clr-namespace:BigSisterNodeNet.Core;assembly=BigSisterNodeNet.Core"
             xmlns:converters="clr-namespace:BigSisterNodeNet.UI.Converters"
             >
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:NodeNetViewModel}">
                <views:NodeNetView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                <views:NodeView />
            </DataTemplate>

            <instrumentViewModels:InstrumentViewSelector x:Key="InstrumentViewSelector">

                <instrumentViewModels:InstrumentViewSelector.EmptyTemplate>
                    <DataTemplate>
                        <instrumentsViews:Empty/>
                    </DataTemplate>
                </instrumentViewModels:InstrumentViewSelector.EmptyTemplate>

                <instrumentViewModels:InstrumentViewSelector.FilterTemplate>
                    <DataTemplate>
                        <instrumentsViews:FilterNodeView/>
                    </DataTemplate>
                </instrumentViewModels:InstrumentViewSelector.FilterTemplate>

                <instrumentViewModels:InstrumentViewSelector.FocuserTemplate>
                    <DataTemplate>
                        <instrumentsViews:FocuserNodeView/>
                    </DataTemplate>
                </instrumentViewModels:InstrumentViewSelector.FocuserTemplate>

                <instrumentViewModels:InstrumentViewSelector.NodeNetSocTemplate>
                    <DataTemplate>
                        <instrumentsViews:NodeNet_SOCView/>
                    </DataTemplate>
                </instrumentViewModels:InstrumentViewSelector.NodeNetSocTemplate>

                <instrumentViewModels:InstrumentViewSelector.RotatorTemplate>
                    <DataTemplate>
                        <instrumentsViews:RotatorNodeView/>
                    </DataTemplate>
                </instrumentViewModels:InstrumentViewSelector.RotatorTemplate>

            </instrumentViewModels:InstrumentViewSelector>


            <Style x:Key="NodeExpander" TargetType="Expander">

                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Background="{DynamicResource MaterialDesign.Brush.Primary}" Padding="10,5" CornerRadius="3"> 
                        <TextBlock Text="{Binding}"
                               Foreground="Black"
                               FontWeight="Medium"/>
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>

            </Style>
            <Style x:Key="ColumnCenteredHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ColumnCenteredText" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        </ResourceDictionary>

    </Application.Resources>
</Application>
