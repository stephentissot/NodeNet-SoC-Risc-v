<UserControl x:Class="BigSisterNodeNet.UI.Views.NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BigSisterNodeNet.UI.Views"
             xmlns:settings="clr-namespace:BigSisterNodeNet.UI.Views.Settings"
             xmlns:instruments="clr-namespace:BigSisterNodeNet.UI.Views.Instruments"
             xmlns:vm="clr-namespace:BigSisterNodeNet.UI.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NodeViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        
        <TabControl Style="{x:Null}"
            Background="{DynamicResource MaterialDesign.Brush.Background}">
            <TabControl.Resources>

                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>

            </TabControl.Resources>

            <TabItem Header="Instrument">
                <ContentControl
                    Content="{Binding}"
                    ContentTemplateSelector="{StaticResource InstrumentViewSelector}"/>
            </TabItem>            
            <TabItem Header="General">
                <settings:GeneralSettingsView />
            </TabItem>

            <TabItem Header="Programmation"
                     Visibility="{Binding HasProgrammingTab, Converter={StaticResource BoolToVisibilityConverter}}">
                <instruments:NodeNet_SOCProgrammingView DataContext="{Binding}"/>
            </TabItem>

            <TabItem Header="Network" 
                     Visibility = "{Binding HasNetworkSettings, Converter={StaticResource BoolToVisibilityConverter}}"
                     IsSelected="{Binding IsNetworkTabSelected, Mode=TwoWay}">
                <settings:NetworkSettingsView DataContext="{Binding Network}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </TabItem>

            <TabItem Header="MQTT"
                     Visibility="{Binding HasMqttSettings, Converter={StaticResource BoolToVisibilityConverter}}"
                     IsEnabled="{Binding Network.Enabled}">
                <settings:MqttSettingsView DataContext="{Binding Mqtt}"  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
            </TabItem>


        </TabControl>

    </Grid>
</UserControl>
