<UserControl x:Class="BigSisterNodeNet.UI.Views.Instruments.NodeNet_SOCView"
			 x:Name="Root"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:core="clr-namespace:BigSisterNodeNet.Core.PlcCore;assembly=BigSisterNodeNet.Core"
			 xmlns:vm="clr-namespace:BigSisterNodeNet.UI.Models.Instruments"
			 xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
			 mc:Ignorable="d"
			 d:DataContext="{d:DesignInstance Type=vm:NodeNet_SOCViewModel}"
			 d:DesignHeight="450" d:DesignWidth="900">
	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*"/>
			<ColumnDefinition Width="3*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
			<TextBlock Text="Path" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
			<TextBox Width="320" Text="{Binding BrowsePath, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
			<Button Margin="8,0,0,0" Content="Browse" Command="{Binding BrowsePathCommand}"/>
			<Button Margin="8,0,0,0" Content="Root" Command="{Binding BrowseRootCommand}"/>
			<Button Margin="8,0,0,0" Content="Read States" Command="{Binding ReadStatesCommand}"/>
		</StackPanel>

		<GroupBox Grid.Row="1" Grid.Column="0" Header="PointDefinitionTree" Margin="0,0,8,0">
			<TreeView ItemsSource="{Binding PointDefinitionTree}"
					  SelectedItemChanged="TreeView_SelectedItemChanged"
					  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">
				<TreeView.ItemContainerStyle>
					<Style TargetType="TreeViewItem">
						<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
						<EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeViewItem_PreviewMouseRightButtonDown" />
					</Style>
				</TreeView.ItemContainerStyle>
				<TreeView.Resources>
					<HierarchicalDataTemplate DataType="{x:Type core:PointDefinitionTreeNode}" ItemsSource="{Binding Children}">
						<StackPanel Orientation="Horizontal">
							<StackPanel.ContextMenu>
								<ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
									<MenuItem Header="Browse"
											  Command="{Binding DataContext.BrowseTreeNodeCommand, Source={x:Reference Root}}"
											  CommandParameter="{Binding Path}">
										<MenuItem.Style>
											<Style TargetType="MenuItem">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Device}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Feature}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</MenuItem.Style>
									</MenuItem>
									<MenuItem Header="Add feature"
											  Command="{Binding DataContext.AddFeatureCommand, Source={x:Reference Root}}"
											  CommandParameter="{Binding}">
										<MenuItem.Style>
											<Style TargetType="MenuItem">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Device}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</MenuItem.Style>
									</MenuItem>
									<MenuItem Header="Show state"
											  Command="{Binding DataContext.ShowTreeNodeStateCommand, Source={x:Reference Root}}"
											  CommandParameter="{Binding Path}">
										<MenuItem.Style>
											<Style TargetType="MenuItem">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Feature}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</MenuItem.Style>
									</MenuItem>
									<MenuItem Header="Add point"
											  Command="{Binding DataContext.AddPointCommand, Source={x:Reference Root}}"
											  CommandParameter="{Binding}">
										<MenuItem.Style>
											<Style TargetType="MenuItem">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Feature}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</MenuItem.Style>
									</MenuItem>
									<MenuItem Header="Delete feature"
											  Command="{Binding DataContext.DeleteFeatureCommand, Source={x:Reference Root}}"
											  CommandParameter="{Binding}">
										<MenuItem.Style>
											<Style TargetType="MenuItem">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Feature}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</MenuItem.Style>
									</MenuItem>
									<MenuItem Header="Settings"
											  Command="{Binding DataContext.ShowDefinitionCommand, Source={x:Reference Root}}"
											  CommandParameter="{Binding}">
										<MenuItem.Style>
											<Style TargetType="MenuItem">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Point}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</MenuItem.Style>
									</MenuItem>
									<MenuItem Header="Delete"
											  Command="{Binding DataContext.DeletePointCommand, Source={x:Reference Root}}"
											  CommandParameter="{Binding}">
										<MenuItem.Style>
											<Style TargetType="MenuItem">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Point}">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</MenuItem.Style>
									</MenuItem>
								</ContextMenu>
							</StackPanel.ContextMenu>
							<materialIcons:MaterialIcon Width="16"
														Height="16"
														Margin="0,0,6,0"
														VerticalAlignment="Center">
								<materialIcons:MaterialIcon.Style>
									<Style TargetType="materialIcons:MaterialIcon">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Point}">
												<Setter Property="Visibility" Value="Visible"/>
												<Setter Property="Kind" Value="ArrowBottomLeftBoldBoxOutline"/>
											</DataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Point}"/>
													<Condition Binding="{Binding Definition.Direction}" Value="{x:Static core:PointDirection.Output}"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Kind" Value="ArrowTopRightBoldBoxOutline"/>
											</MultiDataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding NodeType}" Value="{x:Static core:PointDefinitionTreeNodeType.Point}"/>
													<Condition Binding="{Binding Definition.Direction}" Value="{x:Static core:PointDirection.InOut}"/>
												</MultiDataTrigger.Conditions>
												<Setter Property="Kind" Value="ArrowLeftRightBoldOutline"/>
											</MultiDataTrigger>
										</Style.Triggers>
									</Style>
								</materialIcons:MaterialIcon.Style>
							</materialIcons:MaterialIcon>
							<TextBlock Text="{Binding Name}"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
						</StackPanel>
					</HierarchicalDataTemplate>
				</TreeView.Resources>
			</TreeView>
		</GroupBox>

		<GroupBox Grid.Row="1" Grid.Column="1" Header="{Binding DetailsTitle}">
			<Grid>
				<DataGrid ItemsSource="{Binding PointStateRows}"
						  AutoGenerateColumns="False"
						  CanUserAddRows="False"
						  CanUserDeleteRows="False"
						  IsReadOnly="False"
						  HeadersVisibility="Column"
						  RowHeaderWidth="0"
						  Visibility="{Binding IsPointStatesVisible, Converter={StaticResource BoolToVisibilityConverter}}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="DeviceId" Binding="{Binding DeviceId}" Width="120" IsReadOnly="True" />
						<DataGridTextColumn Header="Feature" Binding="{Binding Feature}" Width="140" IsReadOnly="True" />
						<DataGridTextColumn Header="PointId" Binding="{Binding PointId}" Width="140" IsReadOnly="True" />
						<DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="120" IsReadOnly="True" />
						<DataGridTextColumn Header="Last Update (ms)" Binding="{Binding LastUpdateAgeMs}" Width="120" IsReadOnly="True" />
						<DataGridTextColumn Header="Last Good (ms)" Binding="{Binding LastGoodUpdateAgeMs}" Width="120" IsReadOnly="True" />
						<DataGridTemplateColumn Header="Value" Width="*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Grid>
										<TextBlock Text="{Binding DisplayValue}"
												   VerticalAlignment="Center"
												   Visibility="{Binding IsReadOnlyValue, Converter={StaticResource BoolToVisibilityConverter}}"/>
										<TextBox Text="{Binding EditableTextValue, UpdateSourceTrigger=PropertyChanged}"
											 Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
											 LostFocus="PointStateValueTextBox_LostFocus">
											<TextBox.Style>
												<Style TargetType="TextBox">
													<Setter Property="Visibility" Value="Collapsed"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsEditableNumeric}" Value="True">
															<Setter Property="Visibility" Value="Visible"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBox.Style>
										</TextBox>
										<CheckBox IsChecked="{Binding EditableBoolValue, Mode=TwoWay}"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  Click="PointStateValueCheckBox_Click">
											<CheckBox.Style>
												<Style TargetType="CheckBox">
													<Setter Property="Visibility" Value="Collapsed"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsEditableBool}" Value="True">
															<Setter Property="Visibility" Value="Visible"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</CheckBox.Style>
										</CheckBox>
									</Grid>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>

				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
					<StackPanel Margin="10">
						<StackPanel.Resources>
							<Style TargetType="TextBlock">
								<Setter Property="Foreground" Value="White"/>
							</Style>
							<Style TargetType="TextBox">
								<Setter Property="Foreground" Value="Black"/>
							</Style>

						</StackPanel.Resources>
						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0" Text="DeviceId" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.DeviceId, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Grid.Row="1" Text="Feature" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.Feature, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Grid.Row="2" Text="PointId" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.PointId, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Grid.Row="3" Text="DisplayName" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Grid.Row="4" Text="Backend" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" ItemsSource="{Binding SettingsEditor.PointBackends}" SelectedItem="{Binding SettingsEditor.Backend}"/>

							<TextBlock Grid.Row="5" Text="Direction" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" ItemsSource="{Binding SettingsEditor.PointDirections}" SelectedItem="{Binding SettingsEditor.Direction}"/>

							<TextBlock Grid.Row="6" Text="ValueType" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<ComboBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" ItemsSource="{Binding SettingsEditor.PointValueTypes}" SelectedItem="{Binding SettingsEditor.ValueType}"/>

							<TextBlock Grid.Row="7" Text="RefreshMs" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.RefreshMs, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Grid.Row="8" Text="TimeoutMs" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SettingsEditor.TimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>
						</Grid>

						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0" Text="StringCapacity" Margin="0,0,8,8" VerticalAlignment="Center"/>
							<TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.StringCapacity, UpdateSourceTrigger=PropertyChanged}"/>

							<TextBlock Grid.Row="1" Text="Scale" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SettingsEditor.Scale, UpdateSourceTrigger=PropertyChanged}"/>
						</Grid>

						<Grid Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="140"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Row="0" Text="Unit" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SettingsEditor.Unit, UpdateSourceTrigger=PropertyChanged}"/>
						</Grid>

						<GroupBox Header="Modbus" Margin="0,0,0,12"
								  Visibility="{Binding SettingsEditor.IsModbusBackend, Converter={StaticResource BoolToVisibilityConverter}}">
							<Grid Margin="8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="140"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Text="PortIndex" Margin="0,0,8,8" VerticalAlignment="Center"/>
								<TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.PortIndex, UpdateSourceTrigger=PropertyChanged}"/>

								<TextBlock Grid.Row="1" Text="SlaveAddress" Margin="0,0,8,8" VerticalAlignment="Center"/>
								<TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.SlaveAddress, UpdateSourceTrigger=PropertyChanged}"/>

								<TextBlock Grid.Row="2" Text="Address" Margin="0,0,8,8" VerticalAlignment="Center"/>
								<TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.Address, UpdateSourceTrigger=PropertyChanged}"/>

								<TextBlock Grid.Row="3" Text="RegisterCount" Margin="0,0,8,8" VerticalAlignment="Center"/>
								<TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.RegisterCount, UpdateSourceTrigger=PropertyChanged}"/>

								<TextBlock Grid.Row="4" Text="Table" Margin="0,0,8,8" VerticalAlignment="Center"/>
								<ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" ItemsSource="{Binding SettingsEditor.ModbusTables}" SelectedItem="{Binding SettingsEditor.Table}"/>

								<TextBlock Grid.Row="5" Text="Access" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding SettingsEditor.ModbusAccesses}" SelectedItem="{Binding SettingsEditor.Access}"/>
							</Grid>
						</GroupBox>

						<GroupBox Header="NodeNet" Margin="0,0,0,12"
								  Visibility="{Binding SettingsEditor.IsNodeNetBackend, Converter={StaticResource BoolToVisibilityConverter}}">
							<Grid Margin="8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="140"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0" Text="RemoteDeviceId" Margin="0,0,8,8" VerticalAlignment="Center"/>
								<TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.RemoteDeviceId, UpdateSourceTrigger=PropertyChanged}"/>

								<TextBlock Grid.Row="1" Text="RemoteFeature" Margin="0,0,8,8" VerticalAlignment="Center"/>
								<TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SettingsEditor.RemoteFeature, UpdateSourceTrigger=PropertyChanged}"/>

								<TextBlock Grid.Row="2" Text="RemotePointId" Margin="0,0,8,0" VerticalAlignment="Center"/>
								<TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SettingsEditor.RemotePointId, UpdateSourceTrigger=PropertyChanged}"/>
							</Grid>
						</GroupBox>

						<TextBlock Foreground="OrangeRed"
								   Margin="0,0,0,10"
								   TextWrapping="Wrap"
								   Text="{Binding SettingsEditor.ValidationMessage}"
								   Visibility="{Binding SettingsEditor.HasValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

						<Button Content="Update"
								HorizontalAlignment="Right"
								Padding="18,6"
								Command="{Binding UpdatePointDefinitionCommand}"
								IsEnabled="{Binding SettingsEditor.HasChanges}"
								Visibility="{Binding SettingsEditor.HasChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</GroupBox>
	</Grid>
</UserControl>

